  m_Name: 
  m_EditorClassIdentifier: 
  _label: <size=18><b><color=#FF7F50><i>UiLocalizationText</i></color></b></size>
  _localizationId: OpenLeaderboard
  _disableTexts: 0
  _russianText: "\u0414\u043B\u044F \u0442\u043E\u0433\u043E, \u0447\u0442\u043E\u0431\u044B
    \u043E\u0442\u043A\u0440\u044B\u0442\u044C \u0442\u0430\u0431\u043B\u0438\u0446\u0443
    \u043B\u0438\u0434\u0435\u0440\u043E\u0432, \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E
    \u0430\u0432\u0442\u043E\u0440\u0438\u0437\u043E\u0432\u0430\u0442\u044C\u0441\u044F.
    \u0412\u044B \u0445\u043E\u0442\u0438\u0442\u0435 \u0430\u0432\u0442\u043E\u0440\u0438\u0437\u043E\u0432\u0430\u0442\u044C\u0441\u044F?"
  _englishText: To open the leaderboard, you need to log in. Do you want to log in?
  _turkishText: "Liderlik tablosunu a\xE7mak i\xE7in giris yapman\u0131z gerekir.
    Giris yapmak ister misiniz?"
  _tmpText: {fileID: 5699153395900618389}
